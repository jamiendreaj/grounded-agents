{
  "name": "grounded-agents",
  "version": "0.1.0",
  "type": "module",
  "description": "A small framework for agents that must refuse things: grounded in a document, checked after the model has finished, and explicit about why a draft cannot be sent.",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./guards": {
      "types": "./dist/guards.d.ts",
      "import": "./dist/guards.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && ls dist-test/*.test.js >/dev/null && node --test dist-test/*.test.js",
    "prepublishOnly": "npm run build",
    "typecheck:example": "tsc -p examples/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0"
  },
  "keywords": [
    "llm",
    "agent",
    "guardrails",
    "anthropic",
    "claude",
    "refusal"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "types": "./dist/index.d.ts"
}
